# motor/.env — lo genera /instalar. NUNCA lo subas a GitHub (ya está en .gitignore).

# Usuario robot del motor (Firebase Authentication → correo/contraseña)
AGENT_EMAIL=tu-correo+agentes@gmail.com
AGENT_PASSWORD=PEGA_AQUI_LA_CONTRASENA

# Firebase (los mismos valores públicos de app/.env)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Telegram (opcional): bot creado con @BotFather y tu ID de usuario
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Modelo alterno (opcional): cualquier API compatible con OpenAI, para agentes de solo texto.
# Ejemplos: Gemini  https://generativelanguage.googleapis.com/v1beta/openai  (modelo gemini-2.5-flash)
#           OpenRouter https://openrouter.ai/api/v1  (modelos que terminan en :free)
#           Ollama local http://localhost:11434/v1  (sin API key)
# Ojo: muchos planes gratis usan lo que reciben para entrenar. No los uses con datos confidenciales.
ALT_LLM_BASE_URL=
ALT_LLM_API_KEY=
ALT_LLM_MODEL=
