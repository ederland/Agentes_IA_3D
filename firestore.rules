rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuth() && userDoc().role == 'admin';
    }
    function isEmployee() {
      return isAuth() && userDoc().role == 'empleado';
    }
    function isActiveUser() {
      return isAdmin() || isEmployee();
    }
    // Motor de agentes (tu PC): usuario robot de correo/contraseña, sin doc en users. /instalar pone su correo.
    function isAgentBot() {
      return isAuth() && request.auth.token.email == '__CORREO_ROBOT__';
    }
    function isAgentTask(data) {
      return exists(/databases/$(database)/documents/agents/$(data.asignado));
    }
    // Permisos extra del agente en una tarea: solo un admin los pone o los cambia
    function sinPermisosNuevos() {
      return request.resource.data.get('permisosExtra', []).size() == 0;
    }
    function mismosPermisos() {
      return request.resource.data.get('permisosExtra', []) == resource.data.get('permisosExtra', []);
    }
    // Tarea creada por el motor desde una rutina (schedules): mismo asignado y mismos permisos que la rutina
    function esDeRutina(data) {
      return data.get('programadaId', '') is string && data.get('programadaId', '') != ''
        && exists(/databases/$(database)/documents/schedules/$(data.programadaId))
        && get(/databases/$(database)/documents/schedules/$(data.programadaId)).data.activo == true
        && (get(/databases/$(database)/documents/schedules/$(data.programadaId)).data.plantilla.get('paraDepartamento', false) == true
              ? (data.asignado == '' && data.get('paraDepartamento', false) == true)
              : data.asignado == get(/databases/$(database)/documents/schedules/$(data.programadaId)).data.plantilla.asignado)
        && get(/databases/$(database)/documents/schedules/$(data.programadaId)).data.plantilla.get('permisosExtra', []) == data.get('permisosExtra', []);
    }

    // Users: lectura para autenticados; escritura propia o de admin.
    // CANDADO ANTI-FANTASMA: crear un usuario exige incluir el email real
    // de la cuenta de Google — imposible crear docs sin identidad.
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAuth() && (
        isAdmin() ||
        (request.auth.uid == userId &&
          (!('email' in resource.data) || request.resource.data.email == resource.data.email))
      );
      allow delete: if isAdmin();
    }

    // Tasks: todos los activos leen; empleados editan solo las suyas; solo admin elimina
    match /tasks/{taskId} {
      allow read: if isAuth();
      // El coordinador (vía el robot) solo puede crear tareas asignadas a agentes
      allow create: if (isActiveUser() && (isAdmin() || sinPermisosNuevos()))
        || (isAgentBot() && isAgentTask(request.resource.data) && sinPermisosNuevos())
        || (isAgentBot() && esDeRutina(request.resource.data));
      allow update: if isAuth() && (
        isAdmin() ||
        (isEmployee() && mismosPermisos() && (
          resource.data.asignado == request.auth.uid ||
          resource.data.createdBy == request.auth.token.email ||
          // Auto-asignarse: un empleado puede reclamar una tarea PENDIENTE para si mismo
          (resource.data.estado == 'pendiente' && request.resource.data.asignado == request.auth.uid)
        )) ||
        // El robot solo toca tareas de agentes y no puede reasignarlas
        (isAgentBot() && mismosPermisos() && isAgentTask(resource.data) && request.resource.data.asignado == resource.data.asignado) ||
        // ...salvo una tarea de departamento sin tomar, que puede dar a uno de los agentes
        (isAgentBot() && mismosPermisos() && resource.data.get('paraDepartamento', false) == true && resource.data.asignado == ''
          && resource.data.estado == 'pendiente' && isAgentTask(request.resource.data))
      );
      allow delete: if isAdmin();
    }

    // Tareas programadas: el admin las crea y edita; el coordinador (vía el robot) solo crea rutinas para
    // agentes y sin permisos extra; el motor solo actualiza las marcas de ejecución.
    match /schedules/{schedId} {
      allow read: if isActiveUser() || isAgentBot();
      allow create: if isAdmin() || (isAgentBot()
        && exists(/databases/$(database)/documents/agents/$(request.resource.data.plantilla.asignado))
        && request.resource.data.plantilla.get('permisosExtra', []).size() == 0
        && request.resource.data.plantilla.get('paraDepartamento', false) == false);
      allow update: if isAdmin() || (isAgentBot() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['proximaEjecucion', 'ultimaEjecucion', 'ultimaTareaId', 'totalCreadas', 'ejecutarAhora', 'aviso', 'error']));
      allow delete: if isAdmin();
    }

    // Vista previa de los PDF de una entrega (imágenes de cada página): la escribe solo el motor
    match /previews/{taskId} {
      allow read: if isActiveUser();
      allow write: if isAgentBot();
      allow delete: if isAdmin();
    }

    // Skills desde el panel: el admin pide (buscar, revisar, instalar…) y solo el motor responde.
    // El resultado de una revisión lo escribe solo el robot: el panel no puede falsificarlo.
    match /skillOps/{opId} {
      allow read: if isAdmin() || isAgentBot();
      allow create: if isAdmin() && request.resource.data.estado == 'pendiente'
        && request.resource.data.tipo in ['buscar', 'revisar', 'instalar', 'actualizar', 'desinstalar']
        && !('resultado' in request.resource.data);
      allow update: if isAgentBot();
      allow delete: if isAdmin();
    }

    // Config (lista de clientes): leer todos, escribir solo admin
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin() || (isAgentBot() && docId == 'agentWorker');
    }

    // Agencia: fichas de clientes, departamentos y tipos de tarea.
    // El equipo los lee; solo administradores los editan; el motor solo los lee
    // (cada agente recibe únicamente la ficha del cliente de su tarea).
    match /clients/{clientId} {
      allow read: if isActiveUser() || isAgentBot();
      allow write: if isAdmin();
    }
    match /departments/{deptId} {
      allow read: if isActiveUser() || isAgentBot();
      allow write: if isAdmin();
    }
    match /taskTypes/{typeId} {
      allow read: if isActiveUser() || isAgentBot();
      allow write: if isAdmin();
    }

    // Proveedores de modelos de IA (datos públicos). El motor solo escribe el resultado de "Probar conexión".
    match /providers/{provId} {
      allow read: if isActiveUser() || isAgentBot();
      allow write: if isAdmin();
      allow update: if isAgentBot()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prueba', 'pruebaMensaje', 'pruebaFecha', 'modelosDisponibles']);
    }
    // Claves de API: el administrador las escribe pero NADIE las lee desde el navegador; solo el motor.
    match /providerSecrets/{provId} {
      allow read: if isAgentBot();
      allow create, update, delete: if isAdmin();
    }

    // Invitaciones: solo admins gestionan; el invitado necesita leer/borrar la suya al registrarse
    match /invites/{email} {
      allow read, delete: if isAuth();
      allow create, update: if isAdmin();
    }

    // Muro de discusión del equipo
    match /discussions/{postId} {
      allow read: if isAuth();
      allow create, update: if isActiveUser();
      allow delete: if isAuth() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // Discusión (muro público interno)
    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isActiveUser();
      allow update: if isActiveUser();
      allow delete: if isAuth() && (isAdmin() || resource.data.authorUid == request.auth.uid);
    }

    // Agentes de IA: todos los ven en la oficina; solo administradores los gestionan
    match /agents/{agentId} {
      allow read: if isAuth();
      allow write: if isAdmin();
      // El instalador crea los agentes iniciales a través del robot del motor
      allow create: if isAgentBot();
    }

    // Chat con los agentes (uno por agente + 'grupo'): administradores y el robot del motor
    match /agentChats/{chatId}/mensajes/{msgId} {
      allow read: if isAdmin() || isAgentBot();
      allow create: if isAgentBot() || (isAdmin() && request.resource.data.from == 'humano');
      allow update: if isAgentBot();
      allow delete: if isAdmin();
    }

    // Registro de horas trabajadas por día
    match /worklog/{logId} {
      allow read: if isAuth();
      allow create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    // Chat privado
    match /chats/{chatId} {
      allow read: if isAuth();
      allow write: if isActiveUser() && chatId.matches('.*' + request.auth.uid + '.*');

      match /messages/{msgId} {
        allow read: if isAuth() && chatId.matches('.*' + request.auth.uid + '.*');
        allow create: if isActiveUser()
          && chatId.matches('.*' + request.auth.uid + '.*')
          && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
